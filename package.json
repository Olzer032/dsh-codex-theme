{
  "name": "dsh-codex-theme",
  "version": "0.1.0",
  "description": "Measured OpenAI Codex colour layer for the DeepSeek Harness Web UI: 118 --dsw-* token overrides pixel-sampled from the running Codex app, plus five palettes built on Codex's own appearance model.",
  "type": "module",
  "license": "MIT",
  "author": "Olzer032",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "codex",
    "openai-codex",
    "theme",
    "palette",
    "design-tokens"
  ],
  "homepage": "https://awesome-dsh-plugin.com/p/Olzer032/dsh-codex-theme/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olzer032/dsh-codex-theme.git"
  },
  "bugs": {
    "url": "https://github.com/Olzer032/dsh-codex-theme/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
